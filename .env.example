# ==========================================
# The Lenny Growth Assistant - Environment Config
# ==========================================

# Active Model Provider: 'groq' or 'ollama'
LLM_PROVIDER=groq

# Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# PostgreSQL Database (Local or Hosted like Neon / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/lenny_assistant

# Transcripts Data Path
TRANSCRIPTS_DATA_PATH=data/transcripts
